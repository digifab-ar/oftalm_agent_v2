PORT=3001
OPENAI_API_KEY=sk-...
# Modelos por agente: lib/agentModels.js

MQTT_SERVER=mqtt://broker.hivemq.com
MQTT_TOPIC_CMD=foroptero01/cmd
MQTT_TOPIC_STATE=foroptero01/state
MQTT_TOPIC_PANTALLA=foroptero01/pantalla
TOKEN_ESPERADO=foropteroiñaki2022#

# --- Knowledge externo (obligatorio) ---
# Ruta al clone de https://github.com/digifab-ar/Oftalm_agent_v2_prompts_knowledge
# Si se omite, se usa ../Oftalm_agent_v2_prompts_knowledge si existe.
KNOWLEDGE_ROOT=
# Clone/pull en Railway (dejar vacío en local si ya tenés el repo clonado al lado)
KNOWLEDGE_GIT_URL=https://github.com/digifab-ar/Oftalm_agent_v2_prompts_knowledge.git
KNOWLEDGE_GIT_REF=main
# Cache del manifest parseado (ms); default 5000
KNOWLEDGE_MANIFEST_CACHE_MS=5000
# Recarga manual + fallback webhook si no hay firma GitHub
KNOWLEDGE_RELOAD_TOKEN=
# Secreto del webhook GitHub (recomendado en prod)
KNOWLEDGE_GITHUB_WEBHOOK_SECRET=
# false en staging si no querés auto-recarga
KNOWLEDGE_WEBHOOK_ENABLED=true
# Solo si el repo pasa a privado
KNOWLEDGE_GIT_TOKEN=
