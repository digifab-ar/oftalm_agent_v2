PORT=3001
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# Solo modelos reasoning (gpt-5*, o*): minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Pipeline multi-agente (default). Monolito legacy: true
OPENAI_USE_MONOLITH_ORCHESTRATOR=false
# Modelos por agente (opcional; default OPENAI_MODEL)
# OPENAI_MODEL_INTERPRETE=gpt-5-mini
# OPENAI_MODEL_PROTOCOLO=gpt-5-mini
# OPENAI_MODEL_AUDITOR=gpt-5-mini
# OPENAI_MODEL_COMUNICACION=gpt-5-mini
# OPENAI_REASONING_PROTOCOLO=medium
MQTT_SERVER=mqtt://broker.hivemq.com
MQTT_TOPIC_CMD=foroptero01/cmd
MQTT_TOPIC_STATE=foroptero01/state
MQTT_TOPIC_PANTALLA=foroptero01/pantalla
TOKEN_ESPERADO=foropteroiñaki2022#
